/* ===== 全局样式 ===== */

/* 设计Token */
:root {
  --parchment: #FAF3E7;
  --cream-card: #FFF8EE;
  --ink: #2D2A26;
  --ink-light: #6B6560;
  --ink-muted: #9C968F;
  --amber: #D4A35A;
  --amber-light: #E8C88A;
  --amber-bg: #F5E6CA;
  --coral: #C47B5A;
  --sepia: #E6D5B8;
  --sepia-dark: #C4A87C;
  --frame-wood: #8B7355;
  --frame-gold: #B8964A;
  --mode-colorize: #C47B5A;
  --mode-repair: #7A9E7E;
  --mode-enhance: #D4A35A;
  --mode-denoise: #7E8FA3;
}

/* 全局重置 */
page {
  background-color: #FAF3E7;
  color: #2D2A26;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
}

/* ===== 通用工具类 ===== */

/* 容器 */
.container {
  padding: 0 32rpx;
  box-sizing: border-box;
}

.container-lg {
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* Flex布局 */
.flex {
  display: flex;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.items-center {
  align-items: center;
}

.justify-center {
  justify-content: center;
}

.justify-between {
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* 文本对齐 */
.text-center {
  text-align: center;
}

.text-left {
  text-align: left;
}

/* 字体 */
.font-display {
  font-weight: 600;
  letter-spacing: -0.02em;
}

.font-bold {
  font-weight: 700;
}

/* 文本颜色 */
.text-ink {
  color: #2D2A26;
}

.text-ink-light {
  color: #6B6560;
}

.text-ink-muted {
  color: #9C968F;
}

.text-amber {
  color: #D4A35A;
}

.text-coral {
  color: #C47B5A;
}

/* 背景色 */
.bg-parchment {
  background-color: #FAF3E7;
}

.bg-cream {
  background-color: #FFF8EE;
}

.bg-sepia {
  background-color: #E6D5B8;
}

.bg-amber {
  background-color: #D4A35A;
}

.bg-amber-light {
  background-color: #F5E6CA;
}

/* 间距 */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mt-48 { margin-top: 48rpx; }
.mt-64 { margin-top: 64rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.mb-48 { margin-bottom: 48rpx; }
.mb-64 { margin-bottom: 64rpx; }

.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }

.py-24 { padding-top: 24rpx; padding-bottom: 24rpx; }
.py-32 { padding-top: 32rpx; padding-bottom: 32rpx; }
.py-48 { padding-top: 48rpx; padding-bottom: 48rpx; }
.py-64 { padding-top: 64rpx; padding-bottom: 64rpx; }

.px-32 { padding-left: 32rpx; padding-right: 32rpx; }
.px-48 { padding-left: 48rpx; padding-right: 48rpx; }

/* 圆角 */
.rounded-sm { border-radius: 8rpx; }
.rounded-md { border-radius: 16rpx; }
.rounded-lg { border-radius: 24rpx; }
.rounded-xl { border-radius: 32rpx; }
.rounded-full { border-radius: 9999rpx; }

/* 阴影 */
.shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.shadow-md {
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}

.shadow-lg {
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.08);
}

/* ===== 主按钮样式 ===== */
.btn-primary {
  background: linear-gradient(135deg, #D4A35A 0%, #C4934A 100%);
  color: #FFFFFF;
  font-weight: 600;
  font-size: 30rpx;
  padding: 28rpx 0;
  border-radius: 24rpx;
  text-align: center;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(212,163,90,0.3);
  transition: all 0.2s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(212,163,90,0.2);
}

/* ===== 次要按钮样式 ===== */
.btn-secondary {
  background: transparent;
  color: #2D2A26;
  font-weight: 600;
  font-size: 30rpx;
  padding: 26rpx 0;
  border-radius: 24rpx;
  text-align: center;
  border: 2rpx solid #C4A87C;
  transition: all 0.2s ease;
}

.btn-secondary:active {
  background: #F5E6CA;
  border-color: #D4A35A;
}

/* ===== 卡片样式 ===== */
.card {
  background: #FFF8EE;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

/* ===== 复古相框 ===== */
.vintage-frame {
  border: 6rpx solid #8B7355;
  border-radius: 8rpx;
  padding: 6rpx;
  background: #FFF8EE;
  box-shadow: inset 0 0 0 1rpx rgba(139,115,85,0.3), 0 8rpx 32rpx rgba(0,0,0,0.1);
}

/* ===== 分割线 ===== */
.divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #C4A87C 50%, transparent 100%);
  margin: 32rpx 0;
}

/* ===== 动画 ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

@keyframes pulse-glow {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.7; }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.animate-fade-in-up {
  animation: fadeInUp 0.6s ease-out forwards;
}

.animate-float {
  animation: float 3s ease-in-out infinite;
}

.animate-pulse-glow {
  animation: pulse-glow 2s ease-in-out infinite;
}

.animate-spin {
  animation: spin 2s linear infinite;
}

/* ===== 标签 ===== */
.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-colorize {
  background: rgba(196,123,90,0.15);
  color: #C47B5A;
}

.badge-repair {
  background: rgba(122,158,126,0.15);
  color: #7A9E7E;
}

.badge-enhance {
  background: rgba(212,163,90,0.15);
  color: #D4A35A;
}

.badge-denoise {
  background: rgba(126,143,163,0.15);
  color: #7E8FA3;
}

/* ===== 模式色条 ===== */
.mode-strip {
  width: 6rpx;
  border-radius: 3rpx;
  flex-shrink: 0;
}

.mode-strip-colorize { background: #C47B5A; }
.mode-strip-repair { background: #7A9E7E; }
.mode-strip-enhance { background: #D4A35A; }
.mode-strip-denoise { background: #7E8FA3; }
