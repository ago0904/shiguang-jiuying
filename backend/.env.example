# 百度AI开放平台 (推荐使用 - 免费额度最多)
# 获取地址: https://ai.baidu.com/
BAIDU_APP_KEY=你的百度API_Key
BAIDU_APP_SECRET=你的百度Secret_Key

# 腾讯云 (可选)
# 获取地址: https://cloud.tencent.com/
TENCENT_SECRET_ID=你的腾讯云SecretId
TENCENT_SECRET_KEY=你的腾讯云SecretKey

# Replicate (可选 - 需要海外网络)
# 获取地址: https://replicate.com/
REPLICATE_API_TOKEN=你的Replicate_Token

# 服务配置
PORT=5000
FLASK_DEBUG=false

# 微信小程序配置 (如需做登录)
WECHAT_APPID=你的小程序AppID
WECHAT_SECRET=你的小程序AppSecret
