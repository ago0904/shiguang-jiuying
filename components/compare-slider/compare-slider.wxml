<view class="compare-slider vintage-frame">
  <!-- 修复后图片（底层） -->
  <image class="compare-slider__image compare-slider__image--result" src="{{resultImage}}" mode="aspectFit" lazy-load />

  <!-- 原图（上层，宽度由sliderPosition控制） -->
  <view class="compare-slider__overlay" style="width: {{sliderPosition}}%;">
    <image class="compare-slider__image compare-slider__image--original" src="{{originalImage}}" mode="aspectFit" lazy-load />
  </view>

  <!-- 滑动条 -->
  <view class="compare-slider__divider" style="left: {{sliderPosition}}%;">
    <view class="compare-slider__handle" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd">
      <text class="handle-arrow handle-arrow--left">◀</text>
      <text class="handle-arrow handle-arrow--right">▶</text>
    </view>
  </view>

  <!-- 标签 -->
  <view class="compare-slider__label compare-slider__label--original">原图</view>
  <view class="compare-slider__label compare-slider__label--result">修复后</view>
</view>
