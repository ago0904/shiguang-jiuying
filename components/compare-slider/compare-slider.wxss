.compare-slider {
  position: relative;
  width: 100%;
  height: 480rpx;
  overflow: hidden;
  user-select: none;
}

/* 修复后图片（底层） */
.compare-slider__image--result {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 原图容器（上层） */
.compare-slider__overlay {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  overflow: hidden;
  z-index: 2;
}

.compare-slider__image--original {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100%;
}

/* 分割线 */
.compare-slider__divider {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #D4A35A;
  box-shadow: 0 0 12rpx rgba(212,163,90,0.5);
  z-index: 3;
  transform: translateX(-50%);
}

/* 滑动把手 */
.compare-slider__handle {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #D4A35A;
  box-shadow: 0 4rpx 16rpx rgba(212,163,90,0.4), 0 0 0 4rpx rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 4;
}

.handle-arrow {
  font-size: 18rpx;
  color: #FFFFFF;
}

.handle-arrow--left {
  margin-right: 2rpx;
}

.handle-arrow--right {
  margin-left: 2rpx;
}

/* 标签 */
.compare-slider__label {
  position: absolute;
  bottom: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  z-index: 5;
}

.compare-slider__label--original {
  left: 16rpx;
  background: rgba(45,42,38,0.6);
  color: #FFFFFF;
}

.compare-slider__label--result {
  right: 16rpx;
  background: rgba(212,163,90,0.85);
  color: #FFFFFF;
}
