.mode-card {
  width: 160rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #FFF8EE;
  border: 2rpx solid #E6D5B8;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.mode-card--selected {
  background: #F5E6CA;
  box-shadow: 0 4rpx 16rpx rgba(212,163,90,0.2);
}

.mode-card:active {
  transform: scale(0.96);
}

.mode-card__strip {
  height: 6rpx;
  width: 100%;
  flex-shrink: 0;
}

.mode-card__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 12rpx;
}

.mode-card__icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.mode-card__name {
  font-size: 26rpx;
  font-weight: 700;
  color: #2D2A26;
  margin-bottom: 8rpx;
  text-align: center;
}

.mode-card__desc {
  font-size: 20rpx;
  color: #6B6560;
  text-align: center;
  line-height: 1.4;
}
