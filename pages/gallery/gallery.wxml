<!-- 画廊页 -->
<view class="container py-32">

  <!-- 页面标题区 -->
  <view class="gallery-header animate-fade-in-up">
    <text class="gallery-title">修复案例画廊</text>
    <text class="gallery-subtitle mt-16">探索AI修复的魔力，看看珍贵的回忆如何重焕光彩</text>
  </view>

  <!-- 筛选标签栏 -->
  <scroll-view class="filter-scroll mt-32" scroll-x="true" show-scrollbar="false">
    <view class="filter-list">
      <block wx:for="{{filters}}" wx:key="key">
        <view
          class="filter-item {{activeFilter === item.key ? 'filter-active' : 'filter-normal'}}"
          data-key="{{item.key}}"
          bindtap="onFilterTap"
        >
          {{item.label}}
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 画廊网格（瀑布流布局） -->
  <view class="gallery-grid mt-32">
    <block wx:for="{{getFilteredList}}" wx:key="id">
      <view class="gallery-card" bindtap="onPreviewImage" data-index="{{index}}">
        <image
          class="gallery-image"
          src="{{item.image}}"
          mode="widthFix"
          lazy-load="true"
        />
        <view class="gallery-info">
          <text class="gallery-item-title">{{item.title}}</text>
          <view class="gallery-meta">
            <text class="badge badge-{{item.mode}}">{{item.modeLabel}}</text>
            <text class="gallery-date">{{item.date}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 底部提示 -->
  <view class="gallery-footer">
    <text>持续更新中...</text>
  </view>

</view>
