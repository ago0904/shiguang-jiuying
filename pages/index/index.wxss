/* ==================== 页面全局 ==================== */
page {
  background-color: #FAF3E7;
  color: #2D2A26;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ==================== 入场动画 ==================== */
.hidden {
  opacity: 0;
  transform: translateY(60rpx);
}

.fade-in-up {
  animation: fadeInUp 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ==================== 区域1：品牌Header ==================== */
.brand-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: rgba(250, 243, 231, 0.95);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 1000;
  box-shadow: 0 2rpx 12rpx rgba(45, 42, 38, 0.06);
  box-sizing: border-box;
}

.brand-left {
  display: flex;
  align-items: center;
}

.brand-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.brand-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #2D2A26;
  letter-spacing: 2rpx;
}

.brand-right {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color 0.2s;
}

.brand-right:active {
  background-color: #F5E6CA;
}

.history-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ==================== 区域2：Hero区域 ==================== */
.hero-section {
  position: relative;
  height: 100vh;
  height: 100dvh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-top: -100rpx;
  padding-top: 100rpx;
}

.hero-bg-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}

.hero-bg {
  width: 100%;
  height: 100%;
  opacity: 0.3;
}

.hero-bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    180deg,
    rgba(250, 243, 231, 0.6) 0%,
    rgba(250, 243, 231, 0.2) 40%,
    rgba(250, 243, 231, 0.6) 100%
  );
}

.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 60rpx;
  width: 100%;
  box-sizing: border-box;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #2D2A26;
  text-align: center;
  line-height: 1.3;
  letter-spacing: 4rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: #6B6560;
  text-align: center;
  margin-top: 24rpx;
  letter-spacing: 2rpx;
}

.hero-cta {
  width: 80%;
  margin-top: 48rpx;
}

.hero-tags {
  margin-top: 16rpx;
}

.hero-tags-text {
  font-size: 22rpx;
  color: #9C968F;
  text-align: center;
  letter-spacing: 1rpx;
}

/* 向下滚动提示箭头 */
.scroll-hint {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
  opacity: 0.7;
}

.scroll-arrow-wrapper {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: float 2s ease-in-out infinite;
}

.scroll-arrow {
  font-size: 32rpx;
  color: #9C968F;
  font-weight: 300;
}

.scroll-hint-text {
  font-size: 20rpx;
  color: #9C968F;
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(16rpx);
  }
}

/* ==================== 通用按钮样式 ==================== */
.btn-primary {
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #D4A35A 0%, #C4934A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(212, 163, 90, 0.35);
  transition: transform 0.2s, box-shadow 0.2s;
}

.btn-primary::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.2),
    transparent
  );
  transition: left 0.5s;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(212, 163, 90, 0.3);
}

.btn-primary:active::after {
  left: 100%;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.btn-arrow {
  font-size: 28rpx;
  color: #FFFFFF;
  margin-left: 12rpx;
  opacity: 0.9;
}

/* ==================== 通用区域标题 ==================== */
.section-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2D2A26;
  text-align: center;
  letter-spacing: 4rpx;
}

.section-line {
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #D4A35A, #E8C88A);
  border-radius: 2rpx;
  margin-top: 16rpx;
}

/* ==================== 区域3：功能特色 ==================== */
.feature-section {
  padding: 80rpx 32rpx;
  background-color: #FAF3E7;
}

.mode-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.mode-card {
  background-color: #FFF8EE;
  border-radius: 24rpx;
  padding: 32rpx 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 42, 38, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}

.mode-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background-color: var(--mode-color, #D4A35A);
}

.mode-card:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(45, 42, 38, 0.04);
}

.mode-card-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  border-radius: 24rpx 24rpx 0 0;
}

.mode-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
}

.mode-icon {
  font-size: 40rpx;
  line-height: 1;
}

.mode-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2A26;
  margin-bottom: 8rpx;
}

.mode-desc {
  font-size: 24rpx;
  color: #6B6560;
  line-height: 1.4;
}

/* ==================== 区域4：案例预览 ==================== */
.case-section {
  padding: 80rpx 0;
  background-color: #FFF8EE;
}

.case-section .section-header {
  padding: 0 32rpx;
}

.case-scroll {
  width: 100%;
}

.case-list {
  display: flex;
  flex-direction: row;
  padding: 0 24rpx;
  gap: 24rpx;
}

/* 尾部留空，让最后一张卡片可以滚到中间 */
.case-list::after {
  content: '';
  flex: 0 0 24rpx;
  min-width: 24rpx;
}

.case-card {
  position: relative;
  width: 500rpx;
  height: 350rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(45, 42, 38, 0.12);
  transition: transform 0.2s;
}

.case-card:active {
  transform: scale(0.97);
}

.case-image {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.case-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 48rpx 24rpx 24rpx;
  background: linear-gradient(
    to top,
    rgba(45, 42, 38, 0.85) 0%,
    rgba(45, 42, 38, 0.4) 60%,
    transparent 100%
  );
  border-radius: 0 0 24rpx 24rpx;
}

.case-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  letter-spacing: 2rpx;
}

.case-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-top: 4rpx;
}

.case-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background-color: rgba(212, 163, 90, 0.9);
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

.case-badge-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ==================== 区域5：用户评价 ==================== */
.review-section {
  padding: 80rpx 32rpx;
  background-color: #FAF3E7;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.review-card {
  background-color: #FFF8EE;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 42, 38, 0.06);
}

.review-user {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.review-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 2rpx solid #F5E6CA;
  object-fit: cover;
}

.review-user-info {
  display: flex;
  flex-direction: column;
}

.review-username {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2A26;
  margin-bottom: 4rpx;
}

.review-stars {
  display: flex;
  flex-direction: row;
}

.star {
  font-size: 24rpx;
  color: #D4A35A;
  margin-right: 2rpx;
}

.review-quote {
  position: relative;
  padding-left: 20rpx;
  border-left: 4rpx solid #D4A35A;
}

.review-content {
  font-size: 28rpx;
  color: #6B6560;
  line-height: 1.6;
}

/* ==================== 区域6：CTA底部 ==================== */
.cta-section {
  position: relative;
  padding: 100rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  min-height: 500rpx;
}

.cta-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}

.cta-bg-image {
  width: 100%;
  height: 100%;
  opacity: 0.15;
  filter: blur(4rpx);
}

.cta-bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    180deg,
    rgba(250, 243, 231, 0.9) 0%,
    rgba(250, 243, 231, 0.95) 50%,
    rgba(250, 243, 231, 0.9) 100%
  );
}

.cta-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.cta-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #2D2A26;
  text-align: center;
  line-height: 1.3;
  margin-bottom: 48rpx;
  letter-spacing: 4rpx;
}

.cta-btn {
  width: 70%;
}

.cta-subtext {
  font-size: 24rpx;
  color: #9C968F;
  text-align: center;
  margin-top: 24rpx;
  letter-spacing: 2rpx;
}

/* 底部留白 */
.bottom-space {
  height: 60rpx;
  background-color: #FAF3E7;
}

/* ==================== 响应式适配 ==================== */
/* 小屏幕设备 */
@media (max-height: 700px) {
  .hero-title {
    font-size: 44rpx;
  }

  .hero-subtitle {
    font-size: 24rpx;
  }

  .scroll-hint {
    bottom: 40rpx;
  }
}

/* 大屏幕设备 */
@media (min-width: 450px) {
  .hero-cta {
    max-width: 560rpx;
  }

  .cta-btn {
    max-width: 490rpx;
  }

  .case-card {
    width: 520rpx;
    height: 370rpx;
  }
}

/* ==================== 安全区域适配（刘海屏） ==================== */
.safe-area-top {
  padding-top: constant(safe-area-inset-top);
  padding-top: env(safe-area-inset-top);
}

.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
