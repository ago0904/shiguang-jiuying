<!--pages/login/login.wxml-->
<view class="login-container">
  <!-- 品牌区域 -->
  <view class="brand-section">
    <image class="logo" src="/images/avatar-option2.png" mode="aspectFit"/>
    <text class="brand-name">拾光旧影</text>
    <text class="brand-slogan">让旧时光，重现光彩</text>
  </view>

  <!-- 登录区域 -->
  <view class="login-section">
    <!-- 未登录状态 -->
    <block wx:if="{{!isLogin}}">
      <view class="login-card">
        <text class="login-title">欢迎使用</text>
        <text class="login-desc">登录后可保存修复记录、享受更多免费次数</text>
        
        <!-- 功能列表 -->
        <view class="feature-list">
          <view class="feature-item">
            <text class="feature-icon">💾</text>
            <text class="feature-text">保存修复历史</text>
          </view>
          <view class="feature-item">
            <text class="feature-icon">🎁</text>
            <text class="feature-text">免费修复3张/月</text>
          </view>
          <view class="feature-item">
            <text class="feature-icon">⚡</text>
            <text class="feature-text">会员无限修复</text>
          </view>
        </view>

        <!-- 微信登录按钮 -->
        <button class="wx-login-btn" bindtap="handleLogin">
          <text class="wx-icon">💬</text>
          <text>微信一键登录</text>
        </button>

        <!-- 游客模式 -->
        <view class="guest-option" bindtap="enterAsGuest">
          <text class="guest-text">暂不登录，游客体验 →</text>
        </view>
      </view>
    </block>

    <!-- 已登录状态 -->
    <block wx:if="{{isLogin}}">
      <view class="user-card">
        <image class="user-avatar" src="{{userInfo.avatar || '/images/avatar-option2.png'}}" mode="aspectFill"/>
        <text class="user-name">{{userInfo.nickname || '微信用户'}}</text>
        <text class="user-id">ID: {{userInfo.id}}</text>
        
        <!-- 用户统计 -->
        <view class="user-stats">
          <view class="stat-item">
            <text class="stat-num">{{userInfo.total_repairs || 0}}</text>
            <text class="stat-label">修复次数</text>
          </view>
          <view class="stat-divider"/>
          <view class="stat-item">
            <text class="stat-num">{{userInfo.free_remaining || 0}}</text>
            <text class="stat-label">剩余免费</text>
          </view>
          <view class="stat-divider"/>
          <view class="stat-item">
            <text class="stat-num">{{userInfo.is_member ? '是' : '否'}}</text>
            <text class="stat-label">会员状态</text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="action-btns">
          <button class="action-btn primary" bindtap="goToRestore">
            <text>开始修复</text>
          </button>
          <button class="action-btn secondary" bindtap="handleLogout">
            <text>退出登录</text>
          </button>
        </view>
      </view>
    </block>
  </view>

  <!-- 底部信息 -->
    <text class="footer-text">登录即表示同意《用户协议》和《隐私政策》</text>
</view>
